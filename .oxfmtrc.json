{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": false,
  "ignorePatterns": [
    "lib/**",
    "nitrogen/generated/**",
    "example/ios/**",
    "example/android/**",
    "example/vendor/**",
    "**/*.md"
  ]
}
