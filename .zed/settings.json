{
  "formatter": {
    "external": {
      "command": "oxfmt",
      "arguments": ["--stdin-filepath", "{buffer_path}"]
    }
  },
  "format_on_save": "on",
  "languages": {
    "JavaScript": {
      "language_servers": ["oxc", "!biome", "!eslint"],
      "code_actions_on_format": { "source.fixAll.oxc": true }
    },
    "JSX": {
      "language_servers": ["oxc", "!biome", "!eslint"],
      "code_actions_on_format": { "source.fixAll.oxc": true }
    },
    "TypeScript": {
      "language_servers": ["oxc", "!biome", "!eslint"],
      "code_actions_on_format": { "source.fixAll.oxc": true }
    },
    "TSX": {
      "language_servers": ["oxc", "!biome", "!eslint"],
      "code_actions_on_format": { "source.fixAll.oxc": true }
    }
  }
}
